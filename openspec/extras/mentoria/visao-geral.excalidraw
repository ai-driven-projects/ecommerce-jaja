        }
      ],
      "updated": 1789686273207,
      "link": null,
      "locked": false,
      "text": "1. Chama o Sistema B (Estoque) para dar baixa no produto.\n2. Chama o Sistema C (Nota Fiscal) para emitir a NF na Receita.\n3. Chama o Sistema D (Logística) para calcular a rota de entrega.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Chama o Sistema B (Estoque) para dar baixa no produto.\n2. Chama o Sistema C (Nota Fiscal) para emitir a NF na Receita.\n3. Chama o Sistema D (Logística) para calcular a rota de entrega.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
