        }
      ],
      "updated": 1789686273207,
      "link": null,
      "locked": false,
      "text": "O usuário clica em \"Comprar\". Neste\nmomento, o seu Sistema A\n(Checkout/Vendas) tenta fazer tudo\nde uma vez, chamando outros sistemas\nvia HTTP (sincronamente):",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O usuário clica em \"Comprar\". Neste momento, o seu Sistema A (Checkout/Vendas) tenta fazer tudo de uma vez, chamando outros sistemas via HTTP (sincronamente):",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
