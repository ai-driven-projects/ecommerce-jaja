// Prisma models for module: orders

// A cart is 1:1 with a user (`userId`); `userId` stays unique even for
// soft-deleted carts (`deletedAt` set), so the value remains reserved. The
// items have no identity in the domain: the list is replaced as a whole on
// every write, with `position` normalized to 0..n-1 (order of inclusion). No
// price is stored: the lines always read the current catalog price. A
// soft-deleted product keeps its foreign key and shows up as an unavailable
// line; carts never block the (logical) deletion of products, and the
// `Restrict` relations only guard against physical deletes.
model Cart {
  id        String     @id @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid()) @db.Uuid
  cartId    String  @map("cart_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  position  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@unique([cartId, position])
  @@index([productId])
  @@map("cart_items")
}

// An order belongs to a customer (`customerId`), never to the user: only a
// user with a customer record (delivery data) places orders. Items, prices,
// the delivery address (`delivery_*` columns) and the recipient are **copies**
// made when the order is placed and never change when the catalog or the
// customer record change later. The totals are stored only for reading: the
// rule belongs to the `Order` entity, which recomputes them from the items.
// `status` is text (not a PostgreSQL enum), so a new status only needs
// `ORDER_STATUSES`. The date of each step (`placed_at`, `payment_approved_at`,
// `picking_started_at`, `out_for_delivery_at`, `delivered_at`) is stored when the
// order reaches the step and stays null before it; the sequence rule (only the
// next status, dates coherent with the status) belongs to the `Order` entity.
// The `order.placed` event is stored in the outbox
// (`outbox_events`) in the same transaction as the order and the emptied cart.
// The `Restrict` relations only guard against physical deletes, since
// customers and products are soft-deleted.
model Order {
  id                   String      @id @db.Uuid
  customerId           String      @map("customer_id") @db.Uuid
  status               String
  recipientName        String      @map("recipient_name")
  deliveryInstructions String?     @map("delivery_instructions")
  deliveryZipCode      String      @map("delivery_zip_code") @db.Char(8)
  deliveryStreet       String      @map("delivery_street")
  deliveryNumber       String      @map("delivery_number")
  deliveryComplement   String?     @map("delivery_complement")
  deliveryNeighborhood String      @map("delivery_neighborhood")
  deliveryCity         String      @map("delivery_city")
  deliveryState        String      @map("delivery_state") @db.Char(2)
  subtotalCents        Int         @map("subtotal_cents")
  deliveryFeeCents     Int         @map("delivery_fee_cents")
  totalCents           Int         @map("total_cents")
  placedAt             DateTime    @map("placed_at")
  paymentApprovedAt    DateTime?   @map("payment_approved_at")
  pickingStartedAt     DateTime?   @map("picking_started_at")
  outForDeliveryAt     DateTime?   @map("out_for_delivery_at")
  deliveredAt          DateTime?   @map("delivered_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")
  customer             Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                OrderItem[]

  @@index([customerId, placedAt])
  @@index([status, placedAt])
  @@map("orders")
}

// A frozen line of the order. The items have no identity in the domain: the
// list is created as a whole with the order, with `position` = 0..n-1 (the
// order of the cart). `productId` keeps the link with the catalog; name, unit,
// thumbnail and prices are copies.
model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @map("order_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  position       Int
  name           String
  unit           String
  thumbUrl       String? @map("thumb_url")
  unitPriceCents Int     @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int     @map("line_total_cents")
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, position])
  @@index([productId])
  @@map("order_items")
}
