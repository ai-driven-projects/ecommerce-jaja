// Prisma models for the backend messaging infrastructure

// Internal table of the backend that implements `DomainEventRepository` (the
// outbox): the domain modules only know the port, never this table. A use case
// appends the events of an aggregate in the same transaction that persists the
// aggregate, and the relay (`OutboxRelay`) publishes them to the broker later.
// `id` is the id of the domain event, so the same event is never stored twice.
// `status` holds the values of `DomainEventStatus` (`PENDING`, `PUBLISHED`).
// `availableAt` controls when a pending event may be published: today it is
// only pushed forward by the retries after a failed publication.
model OutboxEvent {
  id            String    @id @db.Uuid
  type          String
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  metadata      Json
  occurredAt    DateTime  @map("occurred_at")
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  availableAt   DateTime  @default(now()) @map("available_at")
  publishedAt   DateTime? @map("published_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

// Internal table of the backend that guarantees each message is processed once
// per consumer. The row is stored in the same transaction as the use case called
// by the consumer, so a failure rolls the mark back together with the rest and
// the message is tried again. The key is composite because the same event is
// processed by several consumers (each one with its own row). The table grows
// with use; the cleanup of old rows (by `processedAt`) comes later.
model ProcessedMessage {
  consumer    String
  messageId   String   @map("message_id") @db.Uuid
  messageType String   @map("message_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([consumer, messageId])
  @@index([processedAt])
  @@map("processed_messages")
}
