DB_HOST="localhost"
DB_PORT="5433"
DB_USER="jaja"
DB_PASSWORD="jaja"
DB_NAME="jaja"
DATABASE_URL="postgresql://jaja:jaja@localhost:5433/jaja?schema=public"
PORT="4000"
JWT_SECRET="YOUR_SECRET_HERE"

# Google Geocoding API key (secret, backend only: never expose it to the frontend).
# Enable only the Geocoding API on this key and set a daily request quota.
# Empty: GET /geocoding answers every address with the simulated point
# (Avenida Paulista, 1578 - São Paulo/SP, source "mock").
GOOGLE_MAPS_API_KEY=

# RabbitMQ local (docker-compose.yml): host ports of AMQP and of the management
# panel (http://localhost:15672, user and password "jaja" in development only).
RABBITMQ_PORT="5672"
RABBITMQ_MANAGEMENT_PORT="15672"
# Broker connection used to publish the domain events (development credentials).
# The URL carries user and password: the backend never logs it, only host and port.
RABBITMQ_URL="amqp://jaja:jaja@localhost:5672"
# Durable topic exchange that receives every event; the routing key is the event type.
RABBITMQ_EXCHANGE="jaja.events"
# Development only: durable queue bound with "#" that keeps a copy of every event
# for inspection in the panel. Empty: no queue is created.
RABBITMQ_INSPECTION_QUEUE="jaja.events.all"

# Outbox relay: publishes the pending events inside the backend process.
# "false" turns it off; interval in ms (minimum 100) and events per cycle (1 to 500).
OUTBOX_RELAY_ENABLED="true"
OUTBOX_POLL_INTERVAL_MS="1000"
OUTBOX_BATCH_SIZE="50"
