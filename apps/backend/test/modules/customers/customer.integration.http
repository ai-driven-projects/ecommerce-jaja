### 31. Alteração pelo administrador com outro bairro e sem location -> 200 com neighborhood
### "Bairro Alterado" e o ponto do passo 30 mantido
PUT {{baseUrl}}/customers/{{markPoint.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
  "cpf": "{{seedCustomer.response.body.cpf}}",
  "phone": "{{seedCustomer.response.body.phone}}",
  "address": {
    "zipCode": "{{seedCustomer.response.body.address.zipCode}}",
    "street": "{{seedCustomer.response.body.address.street}}",
    "number": "1578-A",
    "neighborhood": "Bairro Alterado",
    "city": "{{seedCustomer.response.body.address.city}}",
    "state": "{{seedCustomer.response.body.address.state}}"
  }
}

### 32. GET /customers/:id -> 200 com neighborhood "Bairro Alterado" e o ponto do passo 30
GET {{baseUrl}}/customers/{{markPoint.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}

### 33. Restaurar o cliente do seed com os valores do passo 13 (address com location: null) -> 200
PUT {{baseUrl}}/customers/{{seedCustomer.response.body.id}}
Authorization: Bearer {{loginAdmin.response.body.token}}
Content-Type: application/json

{
  "cpf": "{{seedCustomer.response.body.cpf}}",
  "phone": "{{seedCustomer.response.body.phone}}",
  "address": {{seedCustomer.response.body.$.address}},
  "isActive": {{seedCustomer.response.body.isActive}}
}

### 34. GET /me/customer -> 200 igual ao passo 13 (exceto updatedAt), com address.location = null
GET {{baseUrl}}/me/customer
Authorization: Bearer {{loginUser.response.body.token}}
