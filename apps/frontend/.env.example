
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT=3000

# Google Maps no formulário de lojas (/admin/stores/stores).
# A chave é PÚBLICA: o Next copia toda variável NEXT_PUBLIC_* para o JavaScript
# enviado ao navegador. Libere nela só a Maps JavaScript API, com restrição por
# referrer HTTP (http://localhost:3000/* e o domínio de produção) e limite
# diário de requisições. Vazia, o formulário usa o mapa simulado (ponto fixo na
# Avenida Paulista, 1578 – São Paulo/SP, raio de 1 km).
# A geocodificação de endereços usa outra chave, secreta, só no backend
# (GOOGLE_MAPS_API_KEY em apps/backend/.env).
# Trocar o valor exige reiniciar o `next dev` ou refazer o build.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Opcional: marcadores avançados exigem um Map ID; vazio usa DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
