{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["bin", "src", "scripts", "test", "vitest.config.ts"],
  "exclude": ["node_modules", "cdk.out", "src/constructs/db-migration-handler"]
}
