# Ambiente efêmero do backend do Jaja na AWS.
# Copie para apps/infra/.env (ou outro arquivo, indicado em INFRA_ENV_FILE, por exemplo
# INFRA_ENV_FILE=apps/infra/.env.load) e preencha. Os arquivos .env* do infra, exceto este,
# ficam fora do git. Todos os valores são lidos no deploy; nada é fixo no código.
# Variável vazia = padrão indicado (ou o padrão do perfil ENV_SIZE).

# ---------------------------------------------------------------- obrigatórias

# Conta AWS (12 dígitos). O deploy para se as credenciais em uso forem de outra conta.
AWS_ACCOUNT_ID=
# Região, por exemplo sa-east-1 (São Paulo) ou us-east-1.
AWS_REGION=
# Hosted zone JÁ EXISTENTE no Route 53 desta conta (por exemplo exemplo.com.br).
# O ambiente só cria e remove o registro da API; a zona nunca é alterada além disso.
DOMAIN_NAME=

# ---------------------------------------------------------------- identificação

# Prefixo dos recursos e nome da stack (2 a 20 caracteres: minúsculas, dígitos e hífen). Padrão: jaja
ENV_NAME=jaja
# A API fica em https://api.<APP_SUBDOMAIN>.<DOMAIN_NAME>, URL fixa entre recriações. Padrão: jaja
APP_SUBDOMAIN=jaja

# ---------------------------------------------------------------- perfil e dimensões

# Perfil de tamanho: "demo" (padrão) ou "load".
#   demo: 1 task do backend, RDS Single-AZ t4g.micro, broker mq.m7g.medium em instância única, filas classic, 2 AZs
#   load: 2 a 6 tasks com auto scaling por CPU, RDS Multi-AZ m7g.large, broker mq.m7g.large em cluster
#         de 3 nós, filas quorum, 3 AZs
# Criar o ambiente leva ~20-30 min no demo e ~30-45 min no load (o broker e o RDS são o caminho crítico).
ENV_SIZE=demo

# Ajustes individuais (vazio = padrão do perfil).
# Tasks do backend: inicial (1 a 20) e máximo do auto scaling (1 a 50, >= inicial; igual = sem auto scaling).
BACKEND_DESIRED_COUNT=
BACKEND_MAX_COUNT=
# CPU (256, 512, 1024, 2048 ou 4096 unidades) e memória (MiB) de cada task, nas combinações do Fargate.
BACKEND_CPU=
BACKEND_MEMORY=
# Classe do RDS PostgreSQL 16, sem o prefixo "db." (por exemplo t4g.micro, m7g.large) e Multi-AZ (true/false).
DB_INSTANCE_CLASS=
DB_MULTI_AZ=
# Amazon MQ for RabbitMQ: tipo (o RabbitMQ 4 só roda em mq.m7g.*), modo (SINGLE_INSTANCE ou
# CLUSTER_MULTI_AZ) e versão do motor (4.2 ou 4.3).
MQ_INSTANCE_TYPE=
MQ_DEPLOYMENT_MODE=
MQ_ENGINE_VERSION=
# Tipo das filas do backend: classic ou quorum (recomendado com o broker em cluster).
RABBITMQ_QUEUE_TYPE=
# Retenção dos logs no CloudWatch, em dias (1, 3, 5, 7, 14, 30...). Padrão: 3
LOG_RETENTION_DAYS=

# ---------------------------------------------------------------- aplicação

# Segredo do JWT (mínimo de 32 caracteres). Vazio: o deploy gera um aleatório.
# Preenchido: o script de deploy grava o valor no Secrets Manager (nunca no template).
JWT_SECRET=
# Chave da Google Geocoding API (segredo do backend). Vazio: geocodificação simulada.
GOOGLE_MAPS_API_KEY=
# Origens que podem chamar a API pelo navegador, separadas por vírgula. Vazio: qualquer origem.
# Para usar a vitrine local com a API na AWS: CORS_ORIGIN=http://localhost:3000
# e NEXT_PUBLIC_API_URL=https://api.<APP_SUBDOMAIN>.<DOMAIN_NAME> no .env do frontend.
CORS_ORIGIN=
# Multiplica a espera dos serviços simulados do pedido (0 a 10; 0 = sem espera). Padrão: 1
ORDER_SIMULATION_DELAY_FACTOR=
# "true" roda o seed do backend depois da migração, a cada deploy (idempotente). Padrão: false
# ATENÇÃO: os usuários do seed têm senhas conhecidas e ficam acessíveis pela API pública
# enquanto o ambiente existir.
SEED_ON_DEPLOY=false
